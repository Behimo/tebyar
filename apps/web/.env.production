# بیلد وب برای دیپلوی روی vileo.ir — وب و API روی یک دامنه هستند.
# خالی = درخواست‌ها same-origin به /api/v1 می‌روند. برای APK مقدار VITE_API_URL
# در اسکریپت بیلد اندروید به‌صورت env override می‌شود.
VITE_API_URL=
# مقادیر Reverb در .env (توسعه) هستند؛ اینجا عمداً خالی می‌شوند تا
# realtime در پروداکشن کاملاً غیرفعال بماند.
VITE_REVERB_APP_KEY=
VITE_REVERB_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=
